{
  "components" : {
    "schemas" : {
      "Category" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "CsrfView" : {
        "properties" : {
          "headerName" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Menu" : {
        "properties" : {
          "categoryId" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "optionGroups" : {
            "items" : {
              "$ref" : "#/components/schemas/OptionGroup"
            },
            "type" : "array"
          },
          "price" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "MissionTemplate" : {
        "properties" : {
          "expected" : {
            "items" : {
              "$ref" : "#/components/schemas/OrderLine"
            },
            "type" : "array"
          },
          "id" : {
            "type" : "string"
          },
          "instruction" : {
            "type" : "string"
          },
          "payment" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "MissionView" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "instruction" : {
            "type" : "string"
          },
          "templateId" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Option" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "priceDelta" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "OptionGroup" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "options" : {
            "items" : {
              "$ref" : "#/components/schemas/Option"
            },
            "type" : "array"
          },
          "required" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "OrderLine" : {
        "properties" : {
          "menuId" : {
            "type" : "string"
          },
          "optionIds" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "packing" : {
            "type" : "string"
          },
          "quantity" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Scenario" : {
        "properties" : {
          "categories" : {
            "items" : {
              "$ref" : "#/components/schemas/Category"
            },
            "type" : "array"
          },
          "description" : {
            "type" : "string"
          },
          "menus" : {
            "items" : {
              "$ref" : "#/components/schemas/Menu"
            },
            "type" : "array"
          },
          "missions" : {
            "items" : {
              "$ref" : "#/components/schemas/MissionTemplate"
            },
            "type" : "array"
          },
          "packingOptions" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "paymentOptions" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "scenarioId" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "version" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "SessionView" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "mission" : {
            "$ref" : "#/components/schemas/MissionView"
          },
          "scenarioId" : {
            "type" : "string"
          },
          "scenarioVersion" : {
            "format" : "int32",
            "type" : "integer"
          },
          "startedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "status" : {
            "enum" : [ "ACTIVE", "COMPLETED", "CANCELLED" ],
            "type" : "string"
          },
          "uiVariant" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "StartRequest" : {
        "properties" : {
          "scenarioId" : {
            "minLength" : 1,
            "pattern" : "^[a-z][a-z0-9-]{0,63}$",
            "type" : "string"
          },
          "uiVariant" : {
            "minLength" : 1,
            "pattern" : "standard",
            "type" : "string"
          },
          "version" : {
            "format" : "int32",
            "maximum" : 1000000,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "required" : [ "scenarioId", "uiVariant", "version" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Fictional kiosk training, scenario catalog and isolated learning sessions",
    "title" : "SENIOSK API",
    "version" : "0.2.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/csrf" : {
      "get" : {
        "operationId" : "csrf",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CsrfView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Obtain a session-bound CSRF token for write requests",
        "tags" : [ "session-controller" ]
      }
    },
    "/api/scenarios" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Scenario"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List bundled practice scenarios",
        "tags" : [ "scenario-controller" ]
      }
    },
    "/api/scenarios/{scenarioId}/{version}" : {
      "get" : {
        "operationId" : "detail_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "scenarioId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "version",
          "required" : true,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Scenario"
                }
              }
            },
            "description" : "Scenario definition"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Scenario not found"
          }
        },
        "summary" : "Read a specific immutable scenario version",
        "tags" : [ "scenario-controller" ]
      }
    },
    "/api/sessions" : {
      "post" : {
        "description" : "First obtain a CSRF token from GET /api/csrf and retain the same session cookie.",
        "operationId" : "start",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-CSRF-TOKEN",
          "required" : true
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StartRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Session created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid request"
          },
          "403" : {
            "description" : "Missing or invalid CSRF"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Scenario not found"
          }
        },
        "summary" : "Start an isolated training session and assign a mission",
        "tags" : [ "session-controller" ]
      }
    },
    "/api/sessions/{id}" : {
      "get" : {
        "operationId" : "detail",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Owned training session"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Absent or owned by another browser"
          }
        },
        "summary" : "Read a training session owned by this browser",
        "tags" : [ "session-controller" ]
      }
    },
    "/healthz" : {
      "get" : {
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "additionalProperties" : {
                    "type" : "string"
                  },
                  "type" : "object"
                }
              }
            },
            "description" : "Database available"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "additionalProperties" : {
                    "type" : "string"
                  },
                  "type" : "object"
                }
              }
            },
            "description" : "Database unavailable"
          }
        },
        "tags" : [ "health-controller" ]
      }
    }
  }
}
