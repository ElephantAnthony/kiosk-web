{
  "components" : {
    "schemas" : {
      "Ack" : {
        "properties" : {
          "acknowledgedIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "AdminView" : {
        "properties" : {
          "authenticated" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "Batch" : {
        "properties" : {
          "events" : {
            "items" : {
              "$ref" : "#/components/schemas/JsonNode"
            },
            "maxItems" : 20,
            "minItems" : 1,
            "type" : "array"
          }
        },
        "required" : [ "events" ],
        "type" : "object"
      },
      "Category" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "CsrfView" : {
        "properties" : {
          "headerName" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Funnel" : {
        "properties" : {
          "asOf" : {
            "format" : "date-time",
            "type" : "string"
          },
          "from" : {
            "format" : "date",
            "type" : "string"
          },
          "funnel" : {
            "items" : {
              "$ref" : "#/components/schemas/Stage"
            },
            "type" : "array"
          },
          "inactivityMinutes" : {
            "format" : "int32",
            "type" : "integer"
          },
          "metrics" : {
            "$ref" : "#/components/schemas/Metrics"
          },
          "scenarios" : {
            "items" : {
              "$ref" : "#/components/schemas/ScenarioMetrics"
            },
            "type" : "array"
          },
          "toExclusive" : {
            "format" : "date",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "GradeResult" : {
        "properties" : {
          "accuracy" : {
            "type" : "number"
          },
          "clientActiveMs" : {
            "format" : "int64",
            "type" : "integer"
          },
          "completedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "correct" : {
            "type" : "boolean"
          },
          "extra" : {
            "format" : "int32",
            "type" : "integer"
          },
          "matched" : {
            "format" : "int32",
            "type" : "integer"
          },
          "missing" : {
            "format" : "int32",
            "type" : "integer"
          },
          "paymentMatched" : {
            "type" : "boolean"
          },
          "serverElapsedMs" : {
            "format" : "int64",
            "type" : "integer"
          },
          "sessionId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "JsonNode" : { },
      "Line" : {
        "properties" : {
          "menuId" : {
            "minLength" : 1,
            "pattern" : "^[a-z][a-z0-9-]{0,63}$",
            "type" : "string"
          },
          "optionIds" : {
            "items" : {
              "minLength" : 1,
              "pattern" : "^[a-z][a-z0-9-]{0,63}$",
              "type" : "string"
            },
            "maxItems" : 10,
            "minItems" : 0,
            "type" : "array"
          },
          "packing" : {
            "minLength" : 1,
            "pattern" : "DINE_IN|TAKE_OUT",
            "type" : "string"
          },
          "quantity" : {
            "format" : "int32",
            "maximum" : 20,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "required" : [ "menuId", "optionIds", "packing", "quantity" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "password" : {
            "maxLength" : 72,
            "minLength" : 0,
            "type" : "string",
            "writeOnly" : true
          },
          "username" : {
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ],
        "type" : "object"
      },
      "Menu" : {
        "properties" : {
          "categoryId" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "optionGroups" : {
            "items" : {
              "$ref" : "#/components/schemas/OptionGroup"
            },
            "type" : "array"
          },
          "price" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "Metrics" : {
        "properties" : {
          "abandoned" : {
            "format" : "int64",
            "type" : "integer"
          },
          "active" : {
            "format" : "int64",
            "type" : "integer"
          },
          "averageAccuracy" : {
            "format" : "double",
            "type" : "number"
          },
          "averageElapsedMs" : {
            "format" : "double",
            "type" : "number"
          },
          "cancelled" : {
            "format" : "int64",
            "type" : "integer"
          },
          "completed" : {
            "format" : "int64",
            "type" : "integer"
          },
          "graded" : {
            "format" : "int64",
            "type" : "integer"
          },
          "helped" : {
            "format" : "int64",
            "type" : "integer"
          },
          "successRate" : {
            "format" : "double",
            "type" : "number"
          },
          "successful" : {
            "format" : "int64",
            "type" : "integer"
          },
          "total" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "MissionTemplate" : {
        "properties" : {
          "expected" : {
            "items" : {
              "$ref" : "#/components/schemas/OrderLine"
            },
            "type" : "array"
          },
          "id" : {
            "type" : "string"
          },
          "instruction" : {
            "type" : "string"
          },
          "payment" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "MissionView" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "instruction" : {
            "type" : "string"
          },
          "templateId" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Option" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "priceDelta" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "OptionGroup" : {
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          },
          "options" : {
            "items" : {
              "$ref" : "#/components/schemas/Option"
            },
            "type" : "array"
          },
          "required" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      },
      "OrderLine" : {
        "properties" : {
          "menuId" : {
            "type" : "string"
          },
          "optionIds" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "packing" : {
            "type" : "string"
          },
          "quantity" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Scenario" : {
        "properties" : {
          "categories" : {
            "items" : {
              "$ref" : "#/components/schemas/Category"
            },
            "type" : "array"
          },
          "description" : {
            "type" : "string"
          },
          "menus" : {
            "items" : {
              "$ref" : "#/components/schemas/Menu"
            },
            "type" : "array"
          },
          "missions" : {
            "items" : {
              "$ref" : "#/components/schemas/MissionTemplate"
            },
            "type" : "array"
          },
          "packingOptions" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "paymentOptions" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "scenarioId" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "version" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "ScenarioMetrics" : {
        "properties" : {
          "metrics" : {
            "$ref" : "#/components/schemas/Metrics"
          },
          "scenarioId" : {
            "type" : "string"
          },
          "version" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "SessionView" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "mission" : {
            "$ref" : "#/components/schemas/MissionView"
          },
          "scenarioId" : {
            "type" : "string"
          },
          "scenarioVersion" : {
            "format" : "int32",
            "type" : "integer"
          },
          "startedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "status" : {
            "enum" : [ "ACTIVE", "COMPLETED", "CANCELLED" ],
            "type" : "string"
          },
          "uiVariant" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Stage" : {
        "properties" : {
          "conversionFromPrevious" : {
            "format" : "double",
            "type" : "number"
          },
          "notReachedNext" : {
            "format" : "int64",
            "type" : "integer"
          },
          "reached" : {
            "format" : "int64",
            "type" : "integer"
          },
          "stage" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "StartRequest" : {
        "properties" : {
          "scenarioId" : {
            "minLength" : 1,
            "pattern" : "^[a-z][a-z0-9-]{0,63}$",
            "type" : "string"
          },
          "uiVariant" : {
            "minLength" : 1,
            "pattern" : "standard",
            "type" : "string"
          },
          "version" : {
            "format" : "int32",
            "maximum" : 1000000,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "required" : [ "scenarioId", "uiVariant", "version" ],
        "type" : "object"
      },
      "SubmissionRequest" : {
        "properties" : {
          "clientActiveMs" : {
            "format" : "int64",
            "maximum" : 86400000,
            "minimum" : 0,
            "type" : "integer"
          },
          "order" : {
            "items" : {
              "$ref" : "#/components/schemas/Line"
            },
            "maxItems" : 100,
            "minItems" : 0,
            "type" : "array"
          },
          "payment" : {
            "minLength" : 1,
            "pattern" : "CARD|CASH",
            "type" : "string"
          }
        },
        "required" : [ "clientActiveMs", "order", "payment" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Fictional kiosk training, scenario catalog, isolated learning sessions and server grading",
    "title" : "SENIOSK API",
    "version" : "0.3.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/admin/funnel" : {
      "get" : {
        "description" : "UTC start-date cohort, exclusive end date, maximum 366 days. Requires administrator session. Observed cumulative stage coverage differs from authoritative server completion.",
        "operationId" : "funnel",
        "parameters" : [ {
          "in" : "query",
          "name" : "from",
          "required" : false,
          "schema" : {
            "format" : "date",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "to",
          "required" : false,
          "schema" : {
            "format" : "date",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "scenarioId",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "version",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Funnel"
                }
              }
            },
            "description" : "Aggregated cohort"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Funnel"
                }
              }
            },
            "description" : "Invalid filter"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Funnel"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Funnel"
                }
              }
            },
            "description" : "Insufficient role"
          }
        },
        "summary" : "Aggregate an owned administrator report",
        "tags" : [ "funnel-controller" ]
      }
    },
    "/api/admin/login" : {
      "post" : {
        "operationId" : "login",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-CSRF-TOKEN",
          "required" : true
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminView"
                }
              }
            },
            "description" : "Authenticated"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminView"
                }
              }
            },
            "description" : "Invalid input"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminView"
                }
              }
            },
            "description" : "Invalid credentials or administrator disabled"
          },
          "403" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminView"
                }
              }
            },
            "description" : "Invalid CSRF"
          }
        },
        "summary" : "Authenticate an administrator",
        "tags" : [ "admin-auth-controller" ]
      }
    },
    "/api/admin/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-CSRF-TOKEN",
          "required" : true
        } ],
        "responses" : {
          "204" : {
            "description" : "Logged out"
          },
          "401" : {
            "description" : "Not authenticated"
          },
          "403" : {
            "description" : "Invalid CSRF or insufficient role"
          }
        },
        "summary" : "Clear administrator authentication only",
        "tags" : [ "admin-auth-controller" ]
      }
    },
    "/api/admin/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminView"
                }
              }
            },
            "description" : "Administrator authenticated"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminView"
                }
              }
            },
            "description" : "Not authenticated"
          },
          "403" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminView"
                }
              }
            },
            "description" : "Insufficient role"
          }
        },
        "summary" : "Check administrator session",
        "tags" : [ "admin-auth-controller" ]
      }
    },
    "/api/csrf" : {
      "get" : {
        "operationId" : "csrf",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CsrfView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Obtain a session-bound CSRF token for write requests",
        "tags" : [ "session-controller" ]
      }
    },
    "/api/scenarios" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Scenario"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List bundled practice scenarios",
        "tags" : [ "scenario-controller" ]
      }
    },
    "/api/scenarios/{scenarioId}/{version}" : {
      "get" : {
        "operationId" : "detail_1",
        "parameters" : [ {
          "in" : "path",
          "name" : "scenarioId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "version",
          "required" : true,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Scenario"
                }
              }
            },
            "description" : "Scenario definition"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Scenario not found"
          }
        },
        "summary" : "Read a specific immutable scenario version",
        "tags" : [ "scenario-controller" ]
      }
    },
    "/api/sessions" : {
      "post" : {
        "description" : "First obtain a CSRF token from GET /api/csrf and retain the same session cookie.",
        "operationId" : "start",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-CSRF-TOKEN",
          "required" : true
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StartRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Session created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid request"
          },
          "403" : {
            "description" : "Missing or invalid CSRF"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Scenario not found"
          }
        },
        "summary" : "Start an isolated training session and assign a mission",
        "tags" : [ "session-controller" ]
      }
    },
    "/api/sessions/{id}" : {
      "get" : {
        "operationId" : "detail",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Owned training session"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Absent or owned by another browser"
          }
        },
        "summary" : "Read a training session owned by this browser",
        "tags" : [ "session-controller" ]
      }
    },
    "/api/sessions/{id}/cancel" : {
      "post" : {
        "description" : "Repeated cancellation returns the same cancelled session. Completed sessions return 409.",
        "operationId" : "cancel",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-CSRF-TOKEN",
          "required" : true
        }, {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Cancelled session"
          },
          "403" : {
            "description" : "Missing or invalid CSRF"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Session not found"
          },
          "409" : {
            "content" : {
