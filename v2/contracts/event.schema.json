{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seniosk.example/contracts/event.schema.json",
  "title": "SENIOSK training event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "sessionId",
    "sequence",
    "eventType",
    "scenarioId",
    "scenarioVersion",
    "clientTimestamp",
    "uiVariant",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "eventType": {
      "type": "string",
      "enum": [
        "SESSION_STARTED",
        "MISSION_CONFIRMED",
        "CATEGORY_SELECTED",
        "MENU_SELECTED",
        "OPTION_SELECTED",
        "QUANTITY_CHANGED",
        "CART_ADDED",
        "CART_EDITED",
        "CART_REMOVED",
        "BACK",
        "HELP",
        "PAYMENT_ATTEMPTED",
        "ORDER_COMPLETED",
        "SESSION_CANCELLED",
        "STATE_TRANSITION"
      ]
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "scenarioVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "clientTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "uiVariant": {
      "const": "standard"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "SESSION_STARTED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "MISSION_CONFIRMED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "CATEGORY_SELECTED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "categoryId"
            ],
            "properties": {
              "categoryId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "MENU_SELECTED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "menuId"
            ],
            "properties": {
              "menuId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "OPTION_SELECTED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "menuId",
              "groupId",
              "optionId"
            ],
            "properties": {
              "menuId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "groupId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "optionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "QUANTITY_CHANGED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity"
            ],
            "properties": {
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "CART_ADDED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "menuId"
            ],
            "properties": {
              "menuId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "CART_EDITED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "menuId"
            ],
            "properties": {
              "menuId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "CART_REMOVED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "menuId"
            ],
            "properties": {
              "menuId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "BACK"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "HELP"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "open"
            ],
            "properties": {
              "open": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "PAYMENT_ATTEMPTED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "ORDER_COMPLETED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "SESSION_CANCELLED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "STATE_TRANSITION"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "enum": [
                  "START",
                  "STARTING",
                  "MISSION",
                  "MENU",
                  "OPTION",
                  "CART",
                  "PAYMENT",
                  "SUBMITTING",
                  "SUBMIT_ERROR",
                  "COMPLETE",
                  "CANCELLING",
                  "CANCEL_ERROR",
                  "CANCELLED",
                  "EXPIRED"
                ]
              },
              "to": {
                "type": "string",
                "enum": [
                  "START",
                  "STARTING",
                  "MISSION",
                  "MENU",
                  "OPTION",
                  "CART",
                  "PAYMENT",
                  "SUBMITTING",
                  "SUBMIT_ERROR",
                  "COMPLETE",
                  "CANCELLING",
                  "CANCEL_ERROR",
                  "CANCELLED",
                  "EXPIRED"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
