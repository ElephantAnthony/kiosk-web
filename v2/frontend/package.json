{
  "name": "seniosk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": "11.21.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src *.json *.ts *.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xstate": "5.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.6",
    "typescript": "5.9.3",
    "@types/node": "22.15.30",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "vitest": "4.1.0",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.46.3",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2"
  },
  "packageManager": "npm@11.21.2"
}
